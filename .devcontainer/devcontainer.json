{
  "name": "GGW800 / Sphere-DOS",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12-bookworm",
  "remoteUser": "vscode",
  "postCreateCommand": "make bootstrap",
  "waitFor": "postCreateCommand",
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
